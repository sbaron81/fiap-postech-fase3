# Copie para backend.hcl (nao versionado) com o bucket criado pelo bootstrap
# (terraform/bootstrap) e rode:
#   terraform init -backend-config=backend.hcl

bucket       = "fiap-fase3-tfstate-<seu-account-id>"
key          = "fiap-fase3/terraform.tfstate"
region       = "us-east-1"
use_lockfile = true
encrypt      = true
